{
  "name": "collateral",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "server",
    "client",
    "engine"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:engine": "npm run dev -w engine",
    "build": "npm run build -w server && npm run build -w client && npm run build -w engine",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node tests/run-integration.mjs",
    "start": "npm run start -w server"
  },
  "devDependencies": {
    "@babylonjs/serializers": "^8.56.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3"
  }
}
