{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "noEmit": true,
    "useDefineForClassFields": false
  },
  "include": [
    "server/src",
    "client/src",
    "shared",
    "tests",
    "client/vite.config.ts"
  ]
}
